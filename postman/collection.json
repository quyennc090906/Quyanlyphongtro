{
  "info": {
    "_postman_id": "64e6e6b9-7e3c-46ea-a2fb-b57f8448c390",
    "name": "Quản lý phòng trọ REST API",
    "description": "Collection demo. Khai báo adminPassword trong Postman Environment từ .env; không lưu mật khẩu thật trong collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "roomId",
      "value": "POSTMAN-R101"
    },
    {
      "key": "tenantId",
      "value": "POSTMAN-T001"
    },
    {
      "key": "contractId",
      "value": "POSTMAN-C001"
    },
    {
      "key": "invoiceId",
      "value": "POSTMAN-I001"
    },
    {
      "key": "fileId",
      "value": ""
    },
    {
      "key": "fileToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Đăng nhập quản trị viên",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/dashboard?month=2026-11"
      }
    },
    {
      "name": "Danh sách phòng",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/rooms"
      }
    },
    {
      "name": "Tạo phòng demo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{roomId}}\",\n  \"name\": \"Phòng Postman\",\n  \"floor\": 1,\n  \"price\": 2500000,\n  \"deposit\": 2500000,\n  \"maxTenants\": 2,\n  \"area\": 20,\n  \"status\": \"available\",\n  \"currentElectric\": 0,\n  \"currentWater\": 0,\n  \"amenities\": [],\n  \"images\": []\n}"
        },
        "url": "{{baseUrl}}/rooms"
      }
    },
    {
      "name": "Danh sách khách thuê",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/tenants"
      }
    },
    {
      "name": "Danh sách hợp đồng",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/contracts"
      }
    },
    {
      "name": "Danh sách hóa đơn",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/invoices?month=2026-11"
      }
    },
    {
      "name": "Swagger OpenAPI JSON",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/openapi.json"
      }
    },
    {
      "name": "T?o kh?ch thu?",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tenants",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{tenantId}}\",\n  \"fullName\": \"Postman Demo\",\n  \"phone\": \"0900000000\",\n  \"roomId\": \"{{roomId}}\",\n  \"status\": \"active\"\n}"
        }
      }
    },
    {
      "name": "T?o h?p ??ng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contracts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{contractId}}\",\n  \"roomId\": \"{{roomId}}\",\n  \"tenantId\": \"{{tenantId}}\",\n  \"startDate\": \"2026-11-01\",\n  \"rent\": 2500000,\n  \"deposit\": 2500000,\n  \"status\": \"active\"\n}"
        }
      }
    },
    {
      "name": "T?o h?a ??n",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/invoices",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{invoiceId}}\",\n  \"roomId\": \"{{roomId}}\",\n  \"roomName\": \"Ph?ng Postman\",\n  \"month\": \"2026-11\",\n  \"roomPrice\": 2500000,\n  \"oldElectric\": 0,\n  \"newElectric\": 10,\n  \"electricPrice\": 3500,\n  \"oldWater\": 0,\n  \"newWater\": 1,\n  \"waterPrice\": 20000\n}"
        }
      }
    },
    {
      "name": "Ghi nh?n thanh to?n",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"invoiceId\": \"{{invoiceId}}\",\n  \"amount\": 100000,\n  \"method\": \"cash\"\n}"
        }
      }
    },
    {
      "name": "Danh s?ch t?p theo th?c th?",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/files?entityType=room&entityId={{roomId}}"
      }
    },
    {
      "name": "Upload ?nh ho?c PDF (ch?n file trong Postman)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            },
            {
              "key": "entityType",
              "type": "text",
              "value": "room"
            },
            {
              "key": "entityId",
              "type": "text",
              "value": "{{roomId}}"
            }
          ]
        },
        "url": "{{baseUrl}}/files"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Upload tr? HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const file = pm.response.json(); const url = new URL(file.url, pm.variables.get('baseUrl')); pm.collectionVariables.set('fileId', file.id); pm.collectionVariables.set('fileToken', url.searchParams.get('token') || ''); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Xem/t?i n?i dung (JWT t?p 10 ph?t)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/files/{{fileId}}/content?token={{fileToken}}"
      }
    }
  ]
}
